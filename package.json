{
  "name": "@davidcornelson/tsf",
  "version": "1.1.0",
  "description": "Multi-target TypeScript build tool for monorepos",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tsf": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "typescript",
    "build",
    "monorepo",
    "multi-target",
    "cjs",
    "esm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChicagoDave/tsf.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "glob": "^13.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.7 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.2",
    "rollup": "^4.57.1",
    "vitest": "^3.0.0"
  }
}
